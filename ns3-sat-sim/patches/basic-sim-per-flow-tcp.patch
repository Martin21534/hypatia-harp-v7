+// The schedule's additional_parameters column is optional.  Keep all existing
+// schedules unchanged unless they explicitly request a congestion-control type.
+std::string
+GetPerFlowTcpSocketType(const std::string& additionalParameters)
+{
+    const std::string key = "tcp_socket_type=";
+    const std::size_t start = additionalParameters.find(key);
+    if (start == std::string::npos)
+    {
+        return "";
+    }
+
+    const std::size_t valueStart = start + key.size();
+    const std::size_t valueEnd = additionalParameters.find(';', valueStart);
+    return additionalParameters.substr(valueStart, valueEnd - valueStart);
+}
+
+} // namespace
