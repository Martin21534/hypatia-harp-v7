+void
+TcpSocketBase::ProcessOptionHarp(const TcpHeader& header)
+{
+    for (const auto& option : header.GetOptionList())
+    {
+        if (option->GetKind() != TcpOption::HARP)
+        {
+            continue;
+        }
+
+        const auto harp = DynamicCast<const TcpOptionHarp>(option);
+        if (!harp || harp->GetSignal() != TcpOptionHarp::Signal::DATA_MARK)
+        {
+            continue;
+        }
+
+        const bool newEpoch = !m_harpEchoEpochValid || harp->GetEpoch() != m_harpEchoEpoch;
+        if (newEpoch)
+        {
+            m_harpEchoEpochValid = true;
+            m_harpEchoPending = true;
+            m_harpEchoEpoch = harp->GetEpoch();
+            m_harpEchoUntilNs =
+                Simulator::Now().GetNanoSeconds() + m_harpEchoDuration.GetNanoSeconds();
+            m_harpForceImmediateAck = true;
+
+            NS_LOG_INFO("HarpV5Signal"
+                        << " event=MARK_RX"
+                        << " time_ns=" << Simulator::Now().GetNanoSeconds()
+                        << " epoch=" << m_harpEchoEpoch);
+        }
+    }
+}
+
+void
+TcpSocketBase::AddOptionHarp(TcpHeader& header)
+{
+    if (!m_harpEchoPending || !(header.GetFlags() & TcpHeader::ACK))
+    {
+        return;
+    }
+
+    const int64_t nowNs = Simulator::Now().GetNanoSeconds();
+    if (nowNs > m_harpEchoUntilNs)
+    {
+        m_harpEchoPending = false;
+        return;
+    }
+
+    Ptr<TcpOptionHarp> option = CreateObject<TcpOptionHarp>();
+    option->SetSignal(TcpOptionHarp::Signal::DATA_ECHO);
+    option->SetEpoch(m_harpEchoEpoch);
+    if (header.AppendOption(option))
+    {
+        NS_LOG_INFO("HarpV5Signal"
+                    << " event=ECHO_TX"
+                    << " time_ns=" << nowNs
+                    << " epoch=" << m_harpEchoEpoch);
+    }
 }

