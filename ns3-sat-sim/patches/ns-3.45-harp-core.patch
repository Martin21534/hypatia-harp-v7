+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef TCP_OPTION_HARP_H
+#define TCP_OPTION_HARP_H
+
+#include "tcp-option.h"
+
+#include <cstdint>
+
+namespace ns3
+{
+
+/**
+ * Experimental on-wire option used by HARP-Cubic V5.
+ *
+ * The eight serialized bytes are: Kind, Length, 16-bit experimental ID,
+ * signal type, reserved byte and 16-bit handover epoch.  Kind 253 and the
+ * experimental ID follow the RFC 6994 experimental-option format.
+ */
+class TcpOptionHarp : public TcpOption
+{
+  public:
+    enum class Signal : uint8_t
+    {
+        DATA_MARK = 1,
+        DATA_ECHO = 2,
+        ACK_MARK = 3
+    };
+
+    static TypeId GetTypeId();
+
+    TcpOptionHarp();
+    ~TcpOptionHarp() override;
+
+    void Print(std::ostream& os) const override;
+    void Serialize(Buffer::Iterator start) const override;
+    uint32_t Deserialize(Buffer::Iterator start) override;
+
+    uint8_t GetKind() const override;
+    uint32_t GetSerializedSize() const override;
+
+    void SetSignal(Signal signal);
+    Signal GetSignal() const;
+    void SetEpoch(uint16_t epoch);
+    uint16_t GetEpoch() const;
+
+  private:
+    static constexpr uint8_t SERIALIZED_SIZE = 8;
+    static constexpr uint16_t EXPERIMENT_ID = 0x4841; // "HA"
+
+    Signal m_signal{Signal::DATA_MARK};
+    uint16_t m_epoch{0};
+};
+
+} // namespace ns3
+
+#endif // TCP_OPTION_HARP_H
