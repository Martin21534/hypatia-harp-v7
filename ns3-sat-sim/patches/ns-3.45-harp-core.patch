new file mode 100644
index 0000000..c12ec1d
--- /dev/null
+++ b/src/internet/model/tcp-option-harp.cc
@@ -0,0 +1,108 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "tcp-option-harp.h"
+
+#include "ns3/log.h"
+
+namespace ns3
+{
+
+NS_LOG_COMPONENT_DEFINE("TcpOptionHarp");
+NS_OBJECT_ENSURE_REGISTERED(TcpOptionHarp);
+
+TypeId
+TcpOptionHarp::GetTypeId()
+{
+    static TypeId tid = TypeId("ns3::TcpOptionHarp")
+                            .SetParent<TcpOption>()
+                            .SetGroupName("Internet")
+                            .AddConstructor<TcpOptionHarp>();
+    return tid;
+}
+
+TcpOptionHarp::TcpOptionHarp() = default;
+
+TcpOptionHarp::~TcpOptionHarp() = default;
+
+void
+TcpOptionHarp::Print(std::ostream& os) const
+{
+    os << "signal=" << static_cast<uint32_t>(m_signal) << ";epoch=" << m_epoch;
+}
+
+void
+TcpOptionHarp::Serialize(Buffer::Iterator start) const
+{
+    Buffer::Iterator i = start;
+    i.WriteU8(GetKind());
+    i.WriteU8(SERIALIZED_SIZE);
+    i.WriteHtonU16(EXPERIMENT_ID);
+    i.WriteU8(static_cast<uint8_t>(m_signal));
+    i.WriteU8(0);
+    i.WriteHtonU16(m_epoch);
+}
+
+uint32_t
+TcpOptionHarp::Deserialize(Buffer::Iterator start)
+{
+    Buffer::Iterator i = start;
+    if (i.ReadU8() != GetKind() || i.ReadU8() != SERIALIZED_SIZE ||
+        i.ReadNtohU16() != EXPERIMENT_ID)
+    {
+        NS_LOG_WARN("Malformed HARP experimental TCP option");
+        return 0;
+    }
+
+    const uint8_t signal = i.ReadU8();
+    i.ReadU8(); // Reserved for a later negotiated format version.
+    if (signal < static_cast<uint8_t>(Signal::DATA_MARK) ||
+        signal > static_cast<uint8_t>(Signal::ACK_MARK))
+    {
+        NS_LOG_WARN("Unknown HARP signal type " << static_cast<uint32_t>(signal));
+        return 0;
+    }
+
+    m_signal = static_cast<Signal>(signal);
+    m_epoch = i.ReadNtohU16();
+    return GetSerializedSize();
+}
+
+uint8_t
+TcpOptionHarp::GetKind() const
+{
+    return TcpOption::HARP;
+}
+
+uint32_t
+TcpOptionHarp::GetSerializedSize() const
+{
+    return SERIALIZED_SIZE;
+}
+
+void
+TcpOptionHarp::SetSignal(Signal signal)
+{
+    m_signal = signal;
+}
+
+TcpOptionHarp::Signal
+TcpOptionHarp::GetSignal() const
+{
+    return m_signal;
+}
+
+void
+TcpOptionHarp::SetEpoch(uint16_t epoch)
+{
+    m_epoch = epoch;
+}
+
+uint16_t
+TcpOptionHarp::GetEpoch() const
+{
+    return m_epoch;
+}
+
+} // namespace ns3
